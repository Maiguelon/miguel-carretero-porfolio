{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miguel-carretero-portfolio",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./worker.mjs",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "carreteromiguel.com",
      "custom_domain": true
    }
  ]
}
