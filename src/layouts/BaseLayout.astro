---
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

interface Props { title?: string; description?: string; }
const {
  title = 'Miguel Carretero — Product, operations & AI',
  description = 'I turn everyday operational problems into useful tools. Explore my work in content operations, product design and AI-assisted workflows.',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL('/social-card.png', Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f7f6f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={profile.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content="Miguel Carretero — tools for the way people work." />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body id="top">
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
