---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data, id } = project;
---
<article class:list={['project-card', `theme-${data.theme}`]}>
  <a class="project-cover" href={`/projects/${id}/`} aria-label={`Read the ${data.title} case study`}>
    <div class="cover-topline"><span class="eyebrow">{data.category}</span><span class="project-number">{data.number}</span></div>
    <div class="screenshot-frame"><img src={data.cover} alt={data.coverAlt} loading="lazy" decoding="async" width={data.coverWidth} height={data.coverHeight} /></div>
    <span class="cover-arrow"><Arrow diagonal /></span>
  </a>
  <div class="project-card-copy">
    <div class="project-heading"><h3><a href={`/projects/${id}/`}>{data.title}</a></h3><span class:list={['status', { 'status-live': data.status === 'In use' }]}><span></span>{data.status}</span></div>
    <p>{data.summary}</p>
    <div class="project-card-bottom"><span>{data.subtitle}</span><a class="text-link" href={`/projects/${id}/`}>Read the case <Arrow /></a></div>
  </div>
</article>
