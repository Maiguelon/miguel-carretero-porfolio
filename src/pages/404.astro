---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
---
<BaseLayout title="Page not found — Miguel Carretero" description="This page is not here. Explore Miguel Carretero's selected projects instead.">
  <section class="container error-page">
    <p class="eyebrow">404 / A small detour</p>
    <h1>Let's get you<br /><em>back on track.</em></h1>
    <p class="lede">The page you're looking for isn't here.</p>
    <a class="button button-dark" href="/">Back to the portfolio <Arrow /></a>
  </section>
</BaseLayout>
