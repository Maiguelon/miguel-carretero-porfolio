---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';
import '../styles/home.css';
const projects = (await getCollection('projects', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="hero container" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker"><span class="small-dot"></span>Marketing · Operations · Software</p>
      <h1 id="intro-title">Tools for the way<br />people <em>work.</em></h1>
      <p class="lede">I'm Miguel. I turn everyday operational problems into useful tools, combining a marketing background, product thinking and AI-assisted development.</p>
      <div class="hero-actions"><a class="button button-dark" href="#work">Explore my work <Arrow /></a><a class="text-link" href="#about">A little about me <Arrow diagonal /></a></div>
      <p class="hero-location"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>{profile.location}<span>·</span>Open to remote opportunities</p>
    </div>
    <a class="field-note" href="/projects/gestor-aramis/" aria-label="Read how real team feedback shaped Gestor Aramis">
      <div class="note-heading"><span class="eyebrow">From the workbench</span><span class="eyebrow">01 / Gestor</span></div>
      <div class="note-visual"><img src="/images/gestor-design.jpg" width="1264" height="1070" alt="Gestor Aramis production view, with direct access to the script and material." fetchpriority="high" decoding="async" /></div>
      <div class="note-body"><p class="note-title">“What do I do with<br /><em>122 video clips?</em>”</p><p>A teammate's question became a better workflow.</p></div>
      <div class="note-footer"><span>Built around real team feedback</span><Arrow diagonal /></div>
    </a>
  </section>
  <div class="discipline-strip container"><span>A business problem.</span><span>A thoughtful decision.</span><span>A tool people can use.</span><span class="strip-end">That's the thread through my work. <Arrow /></span></div>
  <section id="work" class="work-section container" aria-labelledby="work-title">
    <div class="section-topline"><p class="section-label"><span>01</span> Selected work</p><span class="eyebrow">Built, tested, iterated</span></div>
    <div class="section-heading"><h2 id="work-title">Small teams.<br /><em>Real workflows.</em></h2><p>Two projects exploring how better systems can make planning, handoffs and decisions easier.</p></div>
    <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
    <p class="work-footnote">Product interfaces are in Spanish. Case studies are in English.</p>
  </section>
  <section class="approach container" aria-labelledby="approach-title">
    <div class="section-topline"><p class="section-label"><span>02</span> How I work</p><h2 id="approach-title" class="approach-title">Start with the workflow.</h2></div>
    <div class="approach-grid">
      <article><span class="approach-number">01 / Understand</span><h3>Find the friction.</h3><p>I talk to the people doing the work, map the process and identify where context, time or ownership gets lost.</p></article>
      <article><span class="approach-number">02 / Build</span><h3>Make it concrete.</h3><p>I define the workflow, data model and interface, then work with AI coding tools in small, testable steps.</p></article>
      <article><span class="approach-number">03 / Iterate</span><h3>Learn from actual use.</h3><p>I test the result, listen to feedback and adjust the tool around real constraints. People stay in control of the decisions.</p></article>
    </div>
  </section>
  <section id="about" class="about-section" aria-labelledby="about-title">
    <div class="container about-inner">
      <div class="about-intro"><p class="section-label"><span>03</span> A little about me</p><h2 id="about-title">Marketing taught me<br />to ask <em>why.</em><br />Building lets me<br />do something about it.</h2><p class="about-location">Based in Tucumán, Argentina.<br />Working comfortably in Spanish and English.</p></div>
      <div class="about-copy"><p>I'm Miguel Ángel Carretero. I studied marketing, worked in a B2B software agency, and now lead operations and automation at Aramis, a small marketing agency.</p><p>Working close to clients and a small team has made the problems concrete: scattered files, unclear handoffs, repetitive follow-ups and tools that add more work than they remove.</p><p>I'm also studying programming. I use AI to help build software, while contributing the business context, product decisions and testing that shape what we build.</p><a class="text-link about-link" href={profile.resume} target="_blank" rel="noopener">View my résumé <Arrow diagonal /></a></div>
    </div>
  </section>
  <section class="experience container" aria-labelledby="experience-title">
    <div class="experience-label"><p class="section-label"><span>04</span> Background</p><h2 id="experience-title">The path<br /><em>so far.</em></h2></div>
    <div class="experience-list">
      <article class="experience-row"><div class="experience-date">2025 — Present</div><div><h3>Automation & Operations Lead</h3><p class="experience-company">Aramis Agency · Self-employed</p><p>Coordinate content delivery and client communication, improve production workflows, and build internal tools with the team.</p></div></article>
      <article class="experience-row"><div class="experience-date">2024</div><div><h3>Marketing Assistant</h3><p class="experience-company">Soluntech · B2B software agency</p><p>Worked on customer discovery, structured lead intake, CRM processes and outbound campaigns alongside product and engineering teams.</p></div></article>
      <article class="experience-row"><div class="experience-date">Education</div><div><h3>Marketing + Programming</h3><p class="experience-company">UNSTA · Universidad Nacional de Tucumán</p><p>Bachelor's degree in Marketing, graduated in 2023. University programming degree in progress.</p></div></article>
    </div>
  </section>
  <section id="contact" class="contact-section container" aria-labelledby="contact-title">
    <div class="contact-top"><p class="section-label"><span>05</span> Let's talk</p><span class="contact-caption">Have a role or a problem in mind?</span></div>
    <h2 id="contact-title">Let's make work<br /><em>a little easier.</em></h2>
    <div class="contact-bottom"><a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<Arrow diagonal /></a><div class="social-links"><a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn <Arrow diagonal /></a><a href={profile.github} target="_blank" rel="noopener">GitHub <Arrow diagonal /></a><a href={profile.resume} target="_blank" rel="noopener">Résumé <Arrow diagonal /></a></div></div>
  </section>
</BaseLayout>
