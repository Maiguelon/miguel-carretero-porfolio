---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import '../../styles/case.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.published);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const projects = (await getCollection('projects', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);
const nextProject = projects[(projects.findIndex((item) => item.id === project.id) + 1) % projects.length];
---
<BaseLayout title={`${data.title} — Miguel Carretero`} description={data.summary}>
  <article class:list={['case-page', `theme-${data.theme}`]}>
    <header class="case-header container">
      <a class="text-link case-back" href="/#work"><Arrow />Selected work</a>
      <div class="case-kicker"><p class="eyebrow">Case {data.number} / {data.category}</p><span class="case-status"><span></span>{data.status}</span></div>
      <h1>{data.title}</h1>
      <p class="case-summary">{data.summary}</p>
      <section class="case-brief" aria-labelledby="case-brief-title">
        <h2 id="case-brief-title" class="eyebrow">In brief</h2>
        <dl>{[{ label: 'The problem', text: data.brief.problem }, { label: 'My contribution', text: data.brief.contribution }, { label: 'Result & status', text: data.brief.outcome }].map((item) => <div><dt>{item.label}</dt><dd>{item.text}</dd></div>)}</dl>
      </section>
      <div class="case-actions">{data.demo && !data.demoRequiresLogin ? <a class="button button-dark" href={data.demo} target="_blank" rel="noopener">{data.demoLabel} <Arrow diagonal /></a> : <a class="button button-dark" href="#the-workflow">See the workflow <Arrow /></a>}{data.repository && <a class="text-link" href={data.repository} target="_blank" rel="noopener">View repository <Arrow diagonal /></a>}{data.walkthrough && <a class="text-link" href={data.walkthrough} target="_blank" rel="noopener">Watch walkthrough <Arrow diagonal /></a>}{data.demo && data.demoRequiresLogin && <a class="text-link" href={data.demo} target="_blank" rel="noopener">{data.demoLabel} <Arrow diagonal /></a>}</div>
    </header>
    <figure class="case-cover container"><div class="case-image-wrap"><a href={data.cover} target="_blank" rel="noopener" aria-label={`Open the full ${data.title} screenshot`}><img src={data.cover} alt={data.coverAlt} width={data.coverWidth} height={data.coverHeight} fetchpriority="high" /></a></div><figcaption>{data.coverCaption}<a href={data.cover} target="_blank" rel="noopener">Full screenshot <Arrow diagonal /></a></figcaption></figure>
    <div class="case-content container">
      <aside class="case-sidebar"><div class="case-sidebar-inner">
        <div class="sidebar-fact"><p class="eyebrow">Context</p><p>{data.context}</p></div>
        <div class="sidebar-fact"><p class="eyebrow">Built with</p><ul class="stack-list">{data.stack.map((item) => <li>{item}</li>)}</ul></div>
        <nav class="case-toc" aria-label="On this page"><p class="eyebrow">In this case</p>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
      </div></aside>
      <div class="case-prose"><Content /></div>
    </div>
    {nextProject && nextProject.id !== project.id && <div class="next-project container"><span class="eyebrow">Next case / {nextProject.data.number}</span><a href={`/projects/${nextProject.id}/`}><span>{nextProject.data.title}</span><Arrow diagonal /></a></div>}
    <div class="case-contact container"><p>Have a similar challenge or a role in mind?</p><a class="text-link" href="/#contact">Let's talk <Arrow /></a></div>
  </article>
</BaseLayout>
